{
  "source": "picamera2",
  "output_path": "",
  "max_frames": 0,
  "realtime_source": false,
  "camera_buffer_size": 2,
  "roi_points": [[0, 670], [1080, 670], [1080, 1920], [0, 1920]],
  "roi_expanded_scale": 1.0,
  "temporal_hits": 3,
  "temporal_max_missed": 2,
  "temporal_iou": 0.3,
  "policy_interval_s": 1.0,
  "detector": {
    "model_path": "models/best-seg-2class_320.onnx",
    "image_size": 320,
    "confidence": 0.45,
    "iou": 0.45,
    "device": "cpu",
    "class_names": ["drain_area", "drain_full"],
    "mapping_mode": "auto",
    "agnostic_nms": true
  },
  "storage": {
    "spool_dir": "data/spool",
    "max_gb": 2.0,
    "save_evidence": true,
    "jpeg_quality": 80
  },
  "upload": {
    "url": "http://172.30.1.46:8000/upload",
    "token": "",
    "timeout_s": 10.0,
    "flush_interval_s": 5.0,
    "base_backoff_s": 5.0,
    "max_backoff_s": 60.0
  },
  "gps": {
    "provider": "serial",
    "serial_port": "/dev/ttyUSB0",
    "baudrate": 9600,
    "sample_period_s": 1.0,
    "serial_timeout_s": 1.0,
    "csv_path": "data/gps.csv",
    "replay_speed": 1.0,
    "udp_host": "0.0.0.0",
    "udp_port": 9000
  },
  "blockage": {
    "gully_class_names": ["drain_area"],
    "obstacle_class_names": ["drain_full"],
    "warning_percent": 20.0,
    "critical_percent": 50.0,
    "event_change_percent": 10.0,
    "event_cooldown_s": 3.0
  },
  "policy": {
    "model_path": "",
    "min_safe_battery": 20.0,
    "critical_battery": 8.0,
    "emergency_rain_level": 2,
    "emergency_water_level": 0.85,
    "mode_intervals": {
      "low": 2.0,
      "medium": 0.05,
      "high": 0.033
    }
  },
  "run_preflight": true
}
